# Application
APP_NAME=portal-bps-sumut-backend
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alusi_portal_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m

# SSO BPS RI (OIDC)
SSO_CLIENT_ID=portal-sumut-client
SSO_CLIENT_SECRET=change-this-secret
SSO_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
SSO_ISSUER_URL=https://sso.bps.go.id/realms/bps
SSO_JWKS_URI=https://sso.bps.go.id/realms/bps/protocol/openid-connect/certs

# JWT Session Cookie
JWT_SECRET=alusi-sumut-jwt-super-secret-key-32chars
JWT_EXPIRATION_HOURS=24
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
