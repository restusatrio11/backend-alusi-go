# Application
APP_NAME=portal-bps-sumut-backend
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database PostgreSQL (Direct connection string or individual fields)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alusi_portal_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m

# SSO BPS Sumut (OAuth 2.0 / OIDC)
SSO_CLIENT_ID=app_1791057531231_943f9ac1
SSO_CLIENT_SECRET=YOUR_CLIENT_SECRET
SSO_REDIRECT_URI=https://aron.bps.web.id/callback
SSO_ISSUER_URL=https://otp-dev.bps.web.id

# JWT Session Cookie
JWT_SECRET=alusi-sumut-jwt-super-secret-key-32chars
JWT_EXPIRATION_HOURS=24
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://aron.bps.web.id
