[Unit]
Description=ALUSI Portal Backend API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/GO/AlusiAPI
ExecStart=/www/wwwroot/GO/AlusiAPI/backend-alusi
Restart=always
RestartSec=5s

# Environment File
EnvironmentFile=/www/wwwroot/GO/AlusiAPI/.env

# Security Sandbox (Optional but Recommended)
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

# Standard Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alusi-backend

[Install]
WantedBy=multi-user.target
